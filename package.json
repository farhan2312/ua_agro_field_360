{
  "name": "ua-field-intel",
  "version": "0.1.0",
  "private": true,
  "description": "UA Field Intel — agri-retail field data capture & analytics platform (Kisan Sewa Kendra)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:import": "tsx scripts/import-data.ts",
    "db:import-sales": "tsx scripts/import-sales.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:accounts": "tsx scripts/create-accounts.ts",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma db push && npm run db:import && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "leaflet": "1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "0.468.0",
    "next": "14.2.30",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.16",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "20.17.12",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.30",
    "exceljs": "^4.4.0",
    "postcss": "8.4.49",
    "prisma": "6.5.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "xlsx": "0.18.5"
  }
}
